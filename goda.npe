        "print(\"=\"*70)\n",
        "print(\"📊 MODEL COMPARISON: OLD vs OPTIMIZED\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# ===== المقارنة الصحيحة =====\n",
        "\n",
        "# Old Model Performance (already calculated before)\n",
        "print(\"\\n📊 OLD MODEL (73 features, no SMOTE):\")\n",
        "print(f\"   Training Accuracy: {train_acc:.4f} ({train_acc*100:.2f}%)\")\n",
        "print(f\"   Test Accuracy:     {test_acc:.4f} ({test_acc*100:.2f}%)\")\n",
        "print(f\"   Overfitting Gap:   {(train_acc - test_acc)*100:.2f}%\")\n",
        "\n",
        "# Old Model Confusion Matrix\n",
        "old_cm = cm  # الـ confusion matrix من قبل\n",
        "print(f\"   False Negatives:   {old_cm[1,0]} cases\")\n",
        "\n",
        "# Optimized Model Performance\n",
        "opt_train_pred = model_optimized.predict(scaler_optimized.transform(X_train))\n",
        "opt_test_pred = model_optimized.predict(X_test_scaled)\n",
        "opt_train_acc = accuracy_score(y_train, opt_train_pred)\n",
        "opt_test_acc = accuracy_score(y_test, opt_test_pred)\n",
        "\n",
        "print(\"\\n📊 OPTIMIZED MODEL (30 features, SMOTE, tuned):\")\n",
        "print(f\"   Training Accuracy: {opt_train_acc:.4f} ({opt_train_acc*100:.2f}%)\")\n",
        "print(f\"   Test Accuracy:     {opt_test_acc:.4f} ({opt_test_acc*100:.2f}%)\")\n",
        "print(f\"   Overfitting Gap:   {(opt_train_acc - opt_test_acc)*100:.2f}%\")\n",
        "\n",
        "improvement = (opt_test_acc - test_acc) * 100\n",
        "print(f\"\\n   {'✅' if improvement > 0 else '⚠️'} Test Accuracy Change: {improvement:+.2f}%\")\n",
        "\n",
        "print(\"\\n📋 Detailed Classification Report (Optimized Model):\")\n",
        "print(classification_report(y_test, opt_test_pred,\n",
        "                          target_names=['Bad Risk (0)', 'Good Risk (1)']))\n",
        "\n",
        "print(\"\\n📊 Confusion Matrix (Optimized):\")\n",
        "cm_opt = confusion_matrix(y_test, opt_test_pred)\n",
        "print(cm_opt)\n",
        "print(f\"\\nTrue Negatives (TN):  {cm_opt[0,0]}\")\n",
        "print(f\"False Positives (FP): {cm_opt[0,1]}\")\n",
        "print(f\"False Negatives (FN): {cm_opt[1,0]} ⚠️\")\n",
        "print(f\"True Positives (TP):  {cm_opt[1,1]}\")\n",
        "\n",
        "# مقارنة False Negatives\n",
        "print(f\"\\n📉 False Negatives Comparison:\")\n",
        "print(f\"   Old Model:       {old_cm[1,0]} cases\")\n",
        "print(f\"   Optimized Model: {cm_opt[1,0]} cases\")\n",
        "fn_reduction = old_cm[1,0] - cm_opt[1,0]\n",
        "if fn_reduction > 0:\n",
        "    print(f\"   ✅ Reduction:    {fn_reduction} cases ({(fn_reduction/old_cm[1,0]*100):.1f}%)\")\n",
        "elif fn_reduction < 0:\n",
        "    print(f\"   ⚠️ Increase:     {abs(fn_reduction)} cases\")\n",
        "else:\n",
        "    print(f\"   → Same:          No change\")\n",
        "\n",
        "# مقارنة Recall للفئة الـ Good (الأهم)\n",
        "old_recall = old_cm[1,1] / (old_cm[1,0] + old_cm[1,1])\n",
        "opt_recall = cm_opt[1,1] / (cm_opt[1,0] + cm_opt[1,1])\n",
        "\n",
        "print(f\"\\n📈 Recall for Good Customers (Most Important):\")\n",
        "print(f\"   Old Model:       {old_recall:.4f} ({old_recall*100:.2f}%)\")\n",
        "print(f\"   Optimized Model: {opt_recall:.4f} ({opt_recall*100:.2f}%)\")\n",
        "print(f\"   Change:          {(opt_recall - old_recall)*100:+.2f}%\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"✅ MODEL OPTIMIZATION COMPLETE!\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "# اختيار الموديل الأفضل\n",
        "if opt_test_acc > test_acc:\n",
        "    print(\"\\n🏆 WINNER: Optimized Model (better test accuracy)\")\n",
        "    final_model = model_optimized\n",
        "    final_scaler = scaler_optimized\n",
        "    final_features = top_30_features\n",
        "elif abs(opt_test_acc - test_acc) < 0.01 and (opt_train_acc - opt_test_acc) < (train_acc - test_acc):\n",
        "    print(\"\\n🏆 WINNER: Optimized Model (less overfitting)\")\n",
        "    final_model = model_optimized\n",
        "    final_scaler = scaler_optimized\n",
        "    final_features = top_30_features\n",
        "else:\n",
        "    print(\"\\n🏆 WINNER: Old Model (better overall performance)\")\n",
        "    final_model = model\n",
        "    final_scaler = scaler\n",
        "    final_features = feature_names\n",
        "\n",
        "print(f\"\\n✅ Final Model Selected:\")\n",
        "print(f\"   Features: {len(final_features)}\")\n",
        "print(f\"   Test Accuracy: {max(opt_test_acc, test_acc):.4f}\")"
