      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "print(\"📊 Loading German Credit Dataset (correct format)...\")\n",
        "\n",
        "# قراءة البيانات - 25 عمود\n",
        "df = pd.read_csv('german.data-numeric', sep=r'\\s+', header=None)\n",
        "\n",
        "# تسمية الأعمدة الـ 25 (حسب German Credit Dataset documentation)\n",
        "df.columns = [\n",
        "    'Status_Checking_Account',    # A1\n",
        "    'Duration_Month',              # A2\n",
        "    'Credit_History',              # A3\n",
        "    'Purpose',                     # A4\n",
        "    'Credit_Amount',               # A5\n",
        "    'Savings_Account',             # A6\n",
        "    'Employment_Since',            # A7\n",
        "    'Installment_Rate',            # A8\n",
        "    'Personal_Status_Sex',         # A9\n",
        "    'Other_Debtors',               # A10\n",
        "    'Present_Residence',           # A11\n",
        "    'Property',                    # A12\n",
        "    'Age',                         # A13\n",
        "    'Other_Installment_Plans',     # A14\n",
        "    'Housing',                     # A15\n",
        "    'Existing_Credits',            # A16\n",
        "    'Job',                         # A17\n",
        "    'Num_Dependents',              # A18\n",
        "    'Telephone',                   # A19\n",
        "    'Foreign_Worker',              # A20\n",
        "    'Attribute_21',                # Extra\n",
        "    'Attribute_22',                # Extra\n",
        "    'Attribute_23',                # Extra\n",
        "    'Attribute_24',                # Extra\n",
        "    'Risk'                         # Target (1=Bad, 2=Good)\n",
        "]\n",
        "\n",
        "# تحويل Risk: 1=Bad → 0, 2=Good → 1\n",
        "df['Risk_Binary'] = df['Risk'].map({1: 0, 2: 1})  # 0=Bad Risk, 1=Good Risk\n",
        "\n",
        "print(f\"✅ Dataset loaded successfully!\")\n",
        "print(f\"📊 Shape: {df.shape[0]} rows × {df.shape[1]} columns\")\n",
        "\n",
        "print(f\"\\n📈 Target Variable Distribution:\")\n",
        "print(f\"   Bad Risk (0):  {(df['Risk_Binary'] == 0).sum()} customers (70%)\")\n",
        "print(f\"   Good Risk (1): {(df['Risk_Binary'] == 1).sum()} customers (30%)\")\n",
        "\n",
        "print(f\"\\n👀 First 5 rows:\")\n",
        "print(df.head())\n",
        "\n",
        "print(f\"\\n📊 Basic Statistics:\")\n",
        "print(df[['Age', 'Credit_Amount', 'Duration_Month']].describe())\n",
        "\n",
        "print(f\"\\n🔍 Missing Values:\")\n",
        "print(df.isnull().sum().sum())\n",
        "\n",
        "print(\"\\n✅ Data ready for processing!\")"
      ],
