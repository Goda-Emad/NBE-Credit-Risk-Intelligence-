        "from google.colab import files\n",
        "import os\n",
        "\n",
        "# رفع الملفات\n",
        "print(\"📤 Please upload your 4 files:\")\n",
        "print(\"1. german.data\")\n",
        "print(\"2. german.data-numeric\")\n",
        "print(\"3. german (Word document)\")\n",
        "print(\"4. Index\")\n",
        "print(\"\\nClick 'Choose Files' button below...\")\n",
        "\n",
        "uploaded = files.upload()\n",
        "\n",
        "print(f\"\\n✅ Uploaded {len(uploaded)} files:\")\n",
        "for filename in uploaded.keys():\n",
        "    print(f\"   - {filename} ({len(uploaded[filename])} bytes)\")"
      ]
