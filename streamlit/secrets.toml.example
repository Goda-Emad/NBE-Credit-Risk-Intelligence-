# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and fill in your actual values
# NEVER commit secrets.toml to Git!

# =============================================================================
# DATABASE CONFIGURATION (if using external database)
# =============================================================================
[database]
host = "your-database-host.com"
port = 5432
database = "nbe_credit_risk"
username = "your_db_username"
password = "your_db_password"
ssl_mode = "require"

# =============================================================================
# API KEYS (if integrating with external services)
# =============================================================================
[api_keys]
# National Bank of Egypt Core Banking System API
nbe_cbs_api_key = "your_nbe_cbs_api_key_here"
nbe_cbs_api_secret = "your_nbe_cbs_secret_here"

# Credit Bureau API (e.g., I-Score Egypt)
credit_bureau_api_key = "your_credit_bureau_api_key"
credit_bureau_endpoint = "https://api.creditbureau.eg/v1"

# Email Service (for notifications)
sendgrid_api_key = "your_sendgrid_api_key"
smtp_server = "smtp.gmail.com"
smtp_port = 587
email_username = "creditrisk@nbe.com.eg"
email_password = "your_email_password"

# SMS Service (for alerts)
sms_api_key = "your_sms_api_key"
sms_api_endpoint = "https://api.sms-provider.com"

# =============================================================================
# AUTHENTICATION (if using custom auth)
# =============================================================================
[auth]
jwt_secret_key = "your_super_secret_jwt_key_here_min_32_chars"
session_secret = "your_session_secret_key"
admin_password = "your_admin_password_hash"

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
[external_services]
# Azure/AWS credentials for model storage
azure_storage_account = "your_storage_account"
azure_storage_key = "your_storage_key"
azure_container_name = "nbe-ml-models"

# AWS S3 (alternative)
aws_access_key_id = "your_aws_access_key"
aws_secret_access_key = "your_aws_secret_key"
s3_bucket_name = "nbe-credit-models"
aws_region = "eu-central-1"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
[monitoring]
# DataDog / New Relic / Custom monitoring
datadog_api_key = "your_datadog_api_key"
monitoring_endpoint = "https://monitoring.nbe.com.eg"

# Sentry (error tracking)
sentry_dsn = "https://your_sentry_dsn@sentry.io/project_id"

# =============================================================================
# ENCRYPTION KEYS
# =============================================================================
[encryption]
# For encrypting sensitive customer data
data_encryption_key = "your_32_byte_encryption_key_base64_encoded"
field_level_encryption_key = "your_field_encryption_key"

# =============================================================================
# FEATURE FLAGS (for A/B testing)
# =============================================================================
[feature_flags]
enable_alternative_model = false
enable_advanced_analytics = true
enable_email_notifications = false
enable_sms_alerts = false

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
[model]
# Model version to use in production
active_model_version = "v3.0"
fallback_model_version = "v2.5"

# Model endpoints (if using external ML serving)
model_api_endpoint = "https://ml-api.nbe.com.eg/predict"
model_api_key = "your_ml_api_key"

# =============================================================================
# COMPLIANCE & AUDIT
# =============================================================================
[compliance]
# Central Bank of Egypt reporting endpoint
cbe_reporting_endpoint = "https://reporting.cbe.gov.eg/api"
cbe_api_key = "your_cbe_api_key"
cbe_institution_id = "NBE-001"

# Audit log storage
audit_log_endpoint = "https://audit.nbe.com.eg/logs"
audit_api_key = "your_audit_api_key"

# =============================================================================
# DEVELOPMENT / TESTING
# =============================================================================
[development]
debug_mode = false
test_api_endpoint = "https://test-api.nbe.com.eg"
mock_external_services = false

# =============================================================================
# RATE LIMITING
# =============================================================================
[rate_limiting]
max_requests_per_minute = 60
max_predictions_per_day = 1000
