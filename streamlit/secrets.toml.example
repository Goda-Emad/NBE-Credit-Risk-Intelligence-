# ============================================================================
# Streamlit Secrets Configuration Template
# ============================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your actual values
# 3. NEVER commit secrets.toml to Git (it's in .gitignore)
#
# For Streamlit Cloud deployment:
# - Go to App Settings → Secrets
# - Paste the contents of your secrets.toml file
# ============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
[database]
host = "your-database-host.com"
port = 5432
database = "nbe_credit_risk"
username = "your_db_username"
password = "your_db_password"

# =============================================================================
# API KEYS
# =============================================================================
[api_keys]
# NBE Core Banking System
nbe_cbs_api_key = "your_api_key_here"

# Credit Bureau API
credit_bureau_api_key = "your_credit_bureau_key"

# Email Service (SendGrid/SMTP)
sendgrid_api_key = "your_sendgrid_key"

# =============================================================================
# AUTHENTICATION
# =============================================================================
[auth]
jwt_secret_key = "your_jwt_secret_minimum_32_characters"
admin_password = "your_hashed_admin_password"

# =============================================================================
# CLOUD STORAGE (Optional)
# =============================================================================
[storage]
# AWS S3
aws_access_key_id = "your_aws_access_key"
aws_secret_access_key = "your_aws_secret"
s3_bucket_name = "nbe-models"

# OR Azure Blob Storage
azure_storage_account = "your_storage_account"
azure_storage_key = "your_storage_key"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
[monitoring]
# Sentry for error tracking
sentry_dsn = "https://your_sentry_dsn@sentry.io/project"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
[feature_flags]
enable_email_notifications = false
enable_advanced_analytics = true
enable_alternative_model = false

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
[model]
active_model_version = "v3.0"
